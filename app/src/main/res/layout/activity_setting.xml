<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="#D0FFFFFF"
    android:padding="16dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#222222"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 版本号 -->
    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="版本: 1.0.0"
        android:textSize="15sp"
        android:textColor="#757575"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 清除缓存按钮 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_clear"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_version"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_clear_cache"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="清除缓存"
            android:textSize="16sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:clickable="true"
            android:focusable="true"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- 退出登录按钮 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_logout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/card_clear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="退出登录"
            android:textSize="16sp"
            android:textColor="#F44336"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:clickable="true"
            android:focusable="true"/>

    </com.google.android.material.card.MaterialCardView>

    <!-- 更换背景 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/card_logout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_change_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="更换背景图"
            android:textSize="16sp"
            android:textColor="#2979FF"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:clickable="true"
            android:focusable="true"/>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>