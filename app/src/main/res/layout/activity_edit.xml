<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.edit.EditNoteActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#D0FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="返回"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EEEEEE"
                app:layout_constraintStart_toStartOf="parent"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="保存并同步"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                app:cornerRadius="20dp"
                app:backgroundTint="#2979FF"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#D0FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/card_top_bar">

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入笔记标题"
            android:textSize="20sp"
            android:padding="16dp"
            android:background="@null"/>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#D0FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/card_title">

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <RadioButton
                android:id="@+id/radio_work"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="工作"
                android:textSize="14sp"
                android:layout_marginHorizontal="8dp"/>

            <RadioButton
                android:id="@+id/radio_study"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="学习"
                android:textSize="14sp"
                android:layout_marginHorizontal="8dp"/>

            <RadioButton
                android:id="@+id/radio_life"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="生活"
                android:textSize="14sp"
                android:layout_marginHorizontal="8dp"/>

            <RadioButton
                android:id="@+id/radio_other"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="其他"
                android:textSize="14sp"
                android:layout_marginHorizontal="8dp"/>

        </RadioGroup>
    </androidx.cardview.widget.CardView>

    <!-- 这里我给你补上 ID：card_content -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#D0FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/card_category"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="在这里输入笔记正文内容..."
            android:textSize="16sp"
            android:padding="16dp"
            android:background="@null"
            android:gravity="top|left"
            android:inputType="textMultiLine"/>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>